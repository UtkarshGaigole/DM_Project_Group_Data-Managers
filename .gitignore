# Ignore generated datasets and pipeline outputs
data/raw/*
data/interim/*
data/processed/*

# Preserve data directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Ignore databases
*.db
*.sqlite

# Ignore Mac/Windows system files
.DS_Store
Thumbs.db

# Ignore Python environment files and cache
__pycache__/
*.pyc
.env
venv/
.venv/