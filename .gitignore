# Ignore generated datasets and pipeline outputs
data/raw/*
data/interim/*
data/processed/*

# Preserve data directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/processed/tableau/
data/processed/tableau/*
!data/processed/tableau/.gitkeep

# Ignore databases
*.db
*.sqlite

# Ignore Mac/Windows system files
.DS_Store
Thumbs.db

# Ignore Python environment files and cache
__pycache__/
*.pyc
.env
venv/
.venv/

# Packaged Tableau flows and extracts (too large for GitHub; .tflx goes in the submission ZIP)
*.tflx
*.hyper

# Jupyter
.ipynb_checkpoints/
